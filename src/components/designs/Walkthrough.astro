---
/**
 * The interactive walkthrough of a design: 360° views of the finished, unfurnished rooms, with arrows to move
 * between them and a floor-plan map that follows the visitor.
 *
 * Progressive enhancement: the server renders a poster with a start button and, for visitors without JavaScript,
 * the stills of every room. Nothing of the viewer (Pannellum, the panoramas) is fetched until the visitor starts it.
 * The tour (views, links, yaw, plan positions) is computed from the walkthrough data and the design, at build time.
 */
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { withBase } from "../../lib/paths.ts";
import { getDesign } from "../../designs/index.ts";
import { getWalkthrough } from "../../designs/walkthroughs.ts";
import { planLevels, renderPlan } from "../../designs/plan.ts";
import { walkthroughCopy as copy } from "../../content/walkthrough.ts";

interface Props {
  /** Design slug, e.g. "5-marla" */
  design: string;
}

const { design: slug } = Astro.props;
const found = getWalkthrough(slug);
if (!found) throw new Error(`Design "${slug}" has no walkthrough`);
const { tour } = found;
const { design, facts } = getDesign(slug);

const image = (id: string, thumb = false) => withBase(`/walkthroughs/${slug}/${id}${thumb ? "-thumb" : ""}.jpg`);
const depthImage = (id: string) => withBase(`/walkthroughs/${slug}/${id}-depth.png`);
const start = tour.views.find((v) => v.id === tour.start)!;
// A walking tour moves through the house with depth: every view needs its depth image, or the flat viewer is used
const publicDir = fileURLToPath(new URL("../../../public/", import.meta.url));
const hasDepth = tour.walking && tour.views.every((v) => existsSync(`${publicDir}walkthroughs/${slug}/${v.id}-depth.png`));

// One plan per level of the tour, drawn for the dark viewer
const plans = tour.levels.map((l) => {
  const level = planLevels(design).find((p) => p.id === l.id)!;
  const plan = renderPlan(design, level, facts, { theme: "dark", id: `wt-${slug}-${l.id}` });
  return { ...l, plan };
});

const config = {
  slug,
  start: tour.start,
  walking: tour.walking,
  depth: hasDepth,
  levels: tour.levels,
  views: tour.views.map((v) => ({
    id: v.id,
    label: v.label,
    level: v.level,
    levelName: v.levelName,
    room: v.room,
    yaw: v.yaw,
    point: v.point,
    description: v.description,
    image: image(v.id),
    thumb: image(v.id, true),
    depth: hasDepth ? depthImage(v.id) : "",
    pos: v.pos,
    links: v.links,
  })),
  plan: Object.fromEntries(plans.map((p) => [p.id, [p.plan.width, p.plan.height]])),
  library: withBase("/vendor/pannellum/pannellum.js"),
  style: withBase("/vendor/pannellum/pannellum.css"),
  copy: {
    loading: copy.loading,
    failed: copy.failed,
    retry: copy.retry,
    goTo: "Go to",
    goUpTo: "Go up to",
    moveHere: "Move here",
    goDownTo: "Go down to",
    mapShow: copy.mapShow,
    mapHide: copy.mapHide,
  },
};
---

<div class="wt" data-walkthrough data-config={JSON.stringify(config)}>
  <div class="wt__poster" data-wt-poster>
    <img
      class="wt__poster-img"
      src={image(start.id, true)}
      alt={start.description}
      width="800"
      height="400"
      loading="lazy"
      decoding="async"
    />
    <div class="wt__poster-body">
      <p class="label wt__tag">{copy.conceptTag}</p>
      <button type="button" class="wt__start" data-wt-start hidden>{copy.start}</button>
      <p class="wt__hint dim" data-wt-hint hidden>{copy.startHint}</p>
    </div>
  </div>

  <div class="wt__viewer" data-wt-viewer hidden>
    <div class="wt__stage" data-wt-stage></div>
    <p class="wt__status" role="status" data-wt-status></p>
    <div class="wt__bar">
      <p class="wt__room label" data-wt-room></p>
      <button type="button" class="wt__btn" data-wt-map-toggle aria-expanded="true">{copy.mapHide}</button>
      <button type="button" class="wt__btn" data-wt-full hidden>{copy.fullscreen}</button>
      <button type="button" class="wt__btn" data-wt-close>{copy.close}</button>
    </div>
    <aside class="wt__map" data-wt-map aria-label={copy.mapLabel}>
      {
        tour.levels.length > 1 && (
          <div class="wt__levels" role="group" aria-label={copy.levelLabel}>
            {tour.levels.map((l) => (
              <button type="button" class="wt__level" data-wt-level={l.id} aria-pressed="false">
                {l.name}
              </button>
            ))}
          </div>
        )
      }
      {
        plans.map((p) => (
          <div class="wt__plan" data-wt-plan={p.id} hidden>
            <Fragment set:html={p.plan.svg} />
            <span class="wt__you" data-wt-you aria-hidden="true"></span>
            {tour.views
              .filter((v) => v.level === p.id)
              .map((v) => (
                <button
                  type="button"
                  class="wt__spot"
                  data-wt-spot={v.id}
                  style={`left:${((v.point[0] / p.plan.width) * 100).toFixed(2)}%;top:${((v.point[1] / p.plan.height) * 100).toFixed(2)}%`}
                  aria-label={copy.goTo(v.label)}
                />
              ))}
          </div>
        ))
      }
    </aside>
    <p class="wt__keys dim">{copy.helpKeys}</p>
  </div>

  <noscript>
    <section class="wt__stills" aria-labelledby={`wt-stills-${slug}`}>
      <h3 class="label" id={`wt-stills-${slug}`}>{copy.stillsHeading}</h3>
      <p class="dim">{copy.stillsIntro}</p>
      <ul>
        {
          tour.views.map((v) => (
            <li>
              <figure>
                <img src={image(v.id, true)} alt={v.description} width="800" height="400" loading="lazy" />
                <figcaption>{copy.roomOf(v.label, v.levelName)}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>
  </noscript>
</div>

<script>
  import { DepthViewer, type DepthScene, type Marker } from "./depth-viewer.ts";

  interface Link {
    to: string;
    label: string;
    yaw: number;
    pitch: number;
    distance: number;
    climb: number;
    stair: boolean;
  }
  interface View {
    id: string;
    label: string;
    level: string;
    levelName: string;
    room: string | null;
    yaw: number;
    point: [number, number];
    description: string;
    image: string;
    thumb: string;
    /** The depth image and the eye in metres, for a walking tour */
    depth: string;
    pos: [number, number, number];
    links: Link[];
  }
  // The widest view is the default: zooming in is the visitor's choice
  const WIDE = 120;
  // Phones start zoomed in; desktop starts at the widest view
  const START = matchMedia("(max-width: 40rem)").matches ? 70 : WIDE;
  // How far a step through a door zooms in: always tighter than the start, never past the closest zoom
  const STEP = Math.min(62, START - 20);
  // A little below the horizon, so the circles on the floor are in view
  const TILT = -8;

  interface Config {
    /** A tour of walking links: keep the visitor's heading when they move, even within a room */
    walking: boolean;
    /** Every view has a depth image: move through the house in 3D rather than swapping flat views */
    depth: boolean;
    slug: string;
    start: string;
    levels: { id: string; name: string }[];
    views: View[];
    plan: Record<string, [number, number]>;
    library: string;
    style: string;
    copy: Record<string, string>;
  }

  // Pannellum is a classic script that defines window.pannellum
  declare global {
    interface Window {
      pannellum?: { viewer: (el: HTMLElement, config: unknown) => PannellumViewer };
    }
  }
  interface PannellumViewer {
    loadScene(id: string, pitch?: number, yaw?: number, hfov?: number): void;
    getScene(): string;
    getYaw(): number;
    getHfov(): number;
    getPitch(): number;
    setHfov(hfov: number, animated?: number | boolean): void;
    lookAt(pitch: number, yaw: number, hfov?: number, animated?: number | boolean, callback?: () => void): void;
    on(type: string, fn: (...args: unknown[]) => void): void;
    toggleFullscreen(): void;
    destroy(): void;
  }

  const loadOnce = (() => {
    let promise: Promise<void> | undefined;
    return (config: Config) =>
      (promise ??= new Promise<void>((resolve, reject) => {
        const css = document.createElement("link");
        css.rel = "stylesheet";
        css.href = config.style;
        document.head.append(css);
        const js = document.createElement("script");
        js.src = config.library;
        js.onload = () => resolve();
        js.onerror = () => {
          promise = undefined;
          reject(new Error("Viewer failed to load"));
        };
        document.head.append(js);
      }));
  })();

  function init(root: HTMLElement) {
    const config = JSON.parse(root.dataset.config!) as Config;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const poster = $("[data-wt-poster]");
    const startButton = $<HTMLButtonElement>("[data-wt-start]");
    const hint = $("[data-wt-hint]");
    const viewer = $("[data-wt-viewer]");
    const stage = $("[data-wt-stage]");
    const status = $("[data-wt-status]");
    const roomLabel = $("[data-wt-room]");
    const mapToggle = $<HTMLButtonElement>("[data-wt-map-toggle]");
    const map = $("[data-wt-map]");
    const fullButton = $<HTMLButtonElement>("[data-wt-full]");
    const closeButton = $<HTMLButtonElement>("[data-wt-close]");
    const views = new Map(config.views.map((v) => [v.id, v]));
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // On a phone the map would cover the circles on the floor, so it starts folded away
    if (matchMedia("(max-width: 40rem)").matches) {
      map.hidden = true;
      mapToggle.setAttribute("aria-expanded", "false");
      mapToggle.textContent = config.copy.mapShow;
    }
    startButton.hidden = false;
    hint.hidden = false;
    if (document.fullscreenEnabled) fullButton.hidden = false;

    let pano: PannellumViewer | undefined;
    let dv: DepthViewer | undefined;
    // set when the 3D viewer cannot run here: the flat viewer takes over
    let flat = !config.depth || !DepthViewer.supported();
    let current = config.start;
    let opening = 0;
    let moving = false;
    let arriving = false;

    const sceneId = (id: string) => id;
    const verb = (from: View, l: Link) => {
      const to = views.get(l.to)!;
      const rank = (id: string) => config.levels.findIndex((x) => x.id === id);
      const lead = to.level === from.level ? config.copy.goTo : rank(to.level) > rank(from.level) ? config.copy.goUpTo : config.copy.goDownTo;
      const here = to.level === from.level && to.room === from.room;
      return here ? `${config.copy.moveHere} in ${from.label}` : `${lead} ${l.label}`;
    };

    const say = (text: string, retry?: () => void) => {
      status.replaceChildren(text);
      if (retry) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "wt__btn";
        b.textContent = config.copy.retry;
        b.addEventListener("click", retry);
        status.append(" ", b);
      }
      status.hidden = !text;
    };

    // Scenes are built once; each scene's markers come straight from the tour
    const scenes = () => {
      const out: Record<string, unknown> = {};
      for (const v of config.views) {
        out[sceneId(v.id)] = {
          type: "equirectangular",
          panorama: v.image,
          preview: v.thumb,
          yaw: v.yaw,
          pitch: TILT,
          hotSpots: v.links.map((l) => {
            const target = views.get(l.to)!;
            // Another spot in this room, or a way into the next one
            const inRoom = target.level === v.level && target.room === v.room;
            // A circle on the floor looks smaller the further away it is, and flatter the nearer the horizon
            const size = Math.round(Math.max(34, Math.min(88, 260 / l.distance)));
            const height = Math.round(size * Math.max(0.3, Math.sin((Math.abs(l.pitch) * Math.PI) / 180)));
            const kind = l.climb > 0 ? "up" : l.climb < 0 ? "down" : inRoom ? "spot" : "door";
            return {
              type: "custom",
              yaw: l.yaw,
              pitch: l.pitch,
              cssClass: `wt-marker wt-marker--${kind}`,
              createTooltipFunc: (el: HTMLElement) => {
                el.style.setProperty("--wt-w", `${size}px`);
                el.style.setProperty("--wt-h", `${height}px`);
                el.setAttribute("role", "button");
                el.tabIndex = 0;
                el.setAttribute("aria-label", verb(v, l));
                const tip = document.createElement("span");
                tip.textContent = l.label;
                el.append(tip);
                el.addEventListener("keydown", (e) => {
                  if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    go(l.to);
                  }
                });
              },
              clickHandlerFunc: () => go(l.to),
            };
          }),
        };
      }
      return out;
    };

    const levelButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-wt-level]")];
    const plans = [...root.querySelectorAll<HTMLElement>("[data-wt-plan]")];
    const showLevel = (id: string) => {
      plans.forEach((p) => (p.hidden = p.dataset.wtPlan !== id));
      levelButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.wtLevel === id)));
    };
    levelButtons.forEach((b) =>
      b.addEventListener("click", () => {
        showLevel(b.dataset.wtLevel!);
        updateMap();
      }),
    );

    const you = (level: string) => root.querySelector<HTMLElement>(`[data-wt-plan="${level}"] [data-wt-you]`);
    const updateMap = () => {
      const v = views.get(current)!;
      const shown = plans.find((p) => !p.hidden)?.dataset.wtPlan;
      root.querySelectorAll<HTMLElement>("[data-wt-you]").forEach((el) => (el.hidden = true));
      root.querySelectorAll<HTMLElement>("[data-wt-spot]").forEach((el) => {
        el.classList.toggle("is-current", el.dataset.wtSpot === current);
        el.tabIndex = shown === views.get(el.dataset.wtSpot!)?.level ? 0 : -1;
      });
      if (shown !== v.level) return;
      const dot = you(v.level);
      const size = config.plan[v.level];
      if (!dot || !size) return;
      dot.hidden = false;
      dot.style.left = `${(v.point[0] / size[0]) * 100}%`;
      dot.style.top = `${(v.point[1] / size[1]) * 100}%`;
      setBearing(dot, lookYaw());
    };
    // The plan has +y up and the image centre faces +y, so a viewer yaw is already the clockwise bearing on the plan
    const setBearing = (dot: HTMLElement, yaw: number) => dot.style.setProperty("--wt-yaw", `${yaw.toFixed(0)}deg`);
    const lookYaw = () => (dv ? dv.yaw : pano ? pano.getYaw() : opening);
    const facing = () => {
      if (!pano && !dv) return;
      const dot = you(views.get(current)!.level);
      if (dot) setBearing(dot, lookYaw());
    };

    root.querySelectorAll<HTMLElement>("[data-wt-spot]").forEach((el) =>
      el.addEventListener("click", () => go(el.dataset.wtSpot!)),
    );

    const arrive = () => {
      const v = views.get(current)!;
      roomLabel.textContent = `${v.label} · ${v.levelName}`;
      stage.setAttribute("aria-label", `${v.label}, ${v.levelName.toLowerCase()}. ${v.description}`);
      showLevel(v.level);
      updateMap();
      facing();
      if (dv) {
        dv.setMarkers(markersFor(v));
        dv.prefetch(v.links.map((l) => l.to));
        return;
      }
      // Warm the next views while the visitor looks around
      for (const l of v.links) {
        const t = views.get(l.to);
        if (t) new Image().src = t.image;
      }
    };

    // The 3D viewer's markers: the same circles as the flat viewer's, placed on the floor under each next spot
    const markersFor = (v: View): Marker[] =>
      v.links.map((l) => {
        const target = views.get(l.to)!;
        const inRoom = target.level === v.level && target.room === v.room;
        const kind = l.climb > 0 ? "up" : l.climb < 0 ? "down" : inRoom ? "spot" : "door";
        const el = document.createElement("div");
        el.className = `wt-marker wt-marker--${kind}`;
        el.setAttribute("role", "button");
        // spots on this floor are chosen with the pointer or the arrow keys; only stairs are tab stops
        el.tabIndex = l.climb ? 0 : -1;
        el.setAttribute("aria-label", verb(v, l));
        const tip = document.createElement("span");
        tip.textContent = l.label;
        el.append(tip);
        el.addEventListener("click", () => go(l.to));
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            go(l.to);
          }
        });
        return { to: l.to, el, target: dv!.floor(l.to) };
      });

    // Moving: (flat viewer) turn towards the door, zoom in with a little blur as if walking forward, swap the view, then ease back out
    function go(id: string) {
      if (dv) {
        void walk(id);
        return;
      }
      const target = views.get(id);
      if (!target || !pano || moving) return;
      const from = views.get(current)!;
      const link = from.links.find((l) => l.to === id);
      // Through a door, keep going the way the visitor was heading; to another spot in the same room, face into the room
      const inRoom = target.level === from.level && target.room === from.room;
      opening = link && (config.walking || !inRoom) ? link.yaw : target.yaw;
      const swap = () => {
        current = id;
        arriving = true;
        pano!.loadScene(sceneId(id), TILT, opening, reduced ? START : STEP);
        arrive();
        announce(target.label);
        window.setTimeout(() => settle(), 8000);
      };
      if (reduced) {
        swap();
        return;
      }
      moving = true;
      stage.classList.add("is-moving");
      if (link) pano.lookAt(Math.max(-30, link.pitch / 2), link.yaw, STEP, 700, swap);
      else swap();
    }

    // Walking in 3D: glide to the next spot with the two views blended, without turning the visitor. A choice made
    // while a glide is under way is kept (the latest wins) and carried out from the spot they arrive at.
    async function walk(id: string) {
      const target = views.get(id);
      if (!target || !dv) return;
      if (moving) {
        dv.request({ kind: "id", id });
        return;
      }
      if (id === current) return;
      const from = views.get(current)!;
      const link = from.links.find((l) => l.to === id);
      moving = true;
      // From the map, to a spot not in sight: cut to it, facing as the spot was set up to face
      if (!link) await dv.cut(id, target.yaw);
      else await dv.travel(id);
      if (dv && dv.sceneId === id) {
        current = id;
        arrive();
        announce(target.label);
      }
      moving = false;
      dv?.flush();
    }

    // The new view is in: ease the zoom back out and clear the blur
    function settle() {
      if (!arriving && !moving) return;
      arriving = false;
      moving = false;
      stage.classList.remove("is-moving");
      if (pano && !reduced) pano.setHfov(START, 700);
      facing();
    }

    const announce = (label: string) => {
      status.hidden = false;
      status.textContent = label;
      window.setTimeout(() => {
        if (status.textContent === label) status.textContent = "";
      }, 1500);
    };

    const open = async () => {
      say(config.copy.loading);
      viewer.hidden = false;
      poster.hidden = true;
      if (!flat && !dv) {
        try {
          const scenesById = new Map<string, DepthScene>(
            config.views.map((v) => [v.id, { id: v.id, image: v.image, thumb: v.thumb, depth: v.depth, pos: v.pos }]),
          );
          dv = new DepthViewer(
            stage,
            scenesById,
            {
              minHfov: 50,
              maxHfov: WIDE,
              onLook: facing,
              onPick: (id) => go(id),
              onFail: () => {
                // The 3D viewer cannot show this tour here (a lost graphics context, a missing depth image): use the flat one
                dv?.destroy();
                dv = undefined;
                flat = true;
                void open();
              },
            },
            reduced,
          );
          current = config.start;
          opening = views.get(config.start)!.yaw;
          await dv.start(config.start, opening, TILT, START);
          if (dv) {
            addZoom();
            say("");
            arrive();
            stage.focus();
            return;
          }
        } catch {
          dv?.destroy();
          dv = undefined;
          flat = true;
        }
      }
      if (dv) return;
      try {
        await loadOnce(config);
      } catch {
        say(config.copy.failed, () => void open());
        return;
      }
      if (!pano) {
        pano = window.pannellum!.viewer(stage, {
          default: { firstScene: sceneId(config.start), sceneFadeDuration: reduced ? 0 : 600, autoLoad: true, showControls: true, keyboardZoom: true, mouseZoom: false, hfov: START, minHfov: 50, maxHfov: WIDE, compass: false, showFullscreenCtrl: false },
          scenes: scenes(),
        });
        pano.on("load", () => {
          say("");
          if (arriving) settle();
        });
        pano.on("error", () => say(config.copy.failed, () => void open()));
        pano.on("animatefinished", facing);
        pano.on("mouseup", facing);
        pano.on("touchend", facing);
        pano.on("scenechange", () => facing());
        stage.addEventListener("keyup", facing);
        current = config.start;
        opening = views.get(config.start)!.yaw;
      }
      arrive();
      (viewer.querySelector<HTMLElement>(".pnlm-container") ?? stage).focus?.();
    };

    // the plus and minus buttons the flat viewer draws itself
    const addZoom = () => {
      const box = document.createElement("div");
      box.className = "wt-zoom";
      const buttons: [string, string, number][] = [["Zoom in", "+", -12], ["Zoom out", "\u2212", 12]];
      for (const [label, text, delta] of buttons) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = text;
        b.setAttribute("aria-label", label);
        b.addEventListener("click", () => dv?.setHfov(dv.hfov + delta, 250));
        box.append(b);
      }
      stage.append(box);
    };

    startButton.addEventListener("click", () => void open());
    viewer.addEventListener("keydown", (e) => {
      // Escape leaves the walkthrough, unless the browser is using it to leave full screen
      if (e.key === "Escape" && !document.fullscreenElement) closeButton.click();
    });
    closeButton.addEventListener("click", () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      viewer.hidden = true;
      poster.hidden = false;
      startButton.focus();
    });
    mapToggle.addEventListener("click", () => {
      const hidden = !map.hidden;
      map.hidden = hidden;
      mapToggle.setAttribute("aria-expanded", String(!hidden));
      mapToggle.textContent = hidden ? config.copy.mapShow : config.copy.mapHide;
    });
    fullButton.addEventListener("click", () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void viewer.requestFullscreen();
    });
    // The map's facing cone follows the view while the visitor drags
    window.setInterval(() => {
      if (!viewer.hidden && (pano || dv)) facing();
    }, 200);
  }

  document.querySelectorAll<HTMLElement>("[data-walkthrough]").forEach(init);
</script>

<style>
  .wt {
    position: relative;
    display: grid;
    gap: var(--space-5);
  }

  .wt__poster {
    position: relative;
    display: grid;
    background: var(--ink);
    color: var(--paper);
  }

  .wt__poster-img {
    display: block;
    width: 100%;
    height: auto;
