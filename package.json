{
  "name": "noordevelopers",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "render:og": "node scripts/render-og.mjs",
    "designs:export": "node scripts/export-designs.ts",
    "designs:review": "astro build && node scripts/print-review.mjs",
    "brand:build": "node brand/scripts/make-mark.mjs && node brand/scripts/make-type.mjs && node brand/scripts/build-logo.mjs && node brand/scripts/check-mark.mjs",
    "test": "vitest run --passWithNoTests && node scripts/check-whatsapp-url.ts",
    "render:fetch": "node scripts/blender.mjs fetch",
    "render:still": "node scripts/blender.mjs still",
    "render:frames": "node scripts/blender.mjs frames",
    "render:sheet": "node render/contact_sheet.mjs",
    "render:encode": "node scripts/encode-renders.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "clipper-lib": "6.4.2",
    "opentype.js": "2.0.0",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
