---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollBuildHero from "../components/hero/ScrollBuildHero.astro";
import { heroCopy } from "../components/hero/hero-copy.ts";
import Offerings from "../components/sections/Offerings.astro";
import FullyFinished from "../components/sections/FullyFinished.astro";
import WhatWeBuild from "../components/sections/WhatWeBuild.astro";
import Process from "../components/sections/Process.astro";
import FeaturedDesign from "../components/sections/FeaturedDesign.astro";
import CtaBand from "../components/sections/CtaBand.astro";

// Sections after the hero, in the order the home-page spec requires
const TOTAL = "06";
---

<BaseLayout
  title="Building the Future in Faisalabad"
  description="Noor Developers design and build fully finished houses and commercial buildings in Faisalabad. Call or WhatsApp to talk about your build."
  whatsappMessage={heroCopy.whatsappMessage}
>
  <ScrollBuildHero />
  <Offerings index="01" total={TOTAL} />
  <FullyFinished variant="compact" index="02" total={TOTAL} />
  <WhatWeBuild index="03" total={TOTAL} />
  <Process index="04" total={TOTAL} />
  <FeaturedDesign slug="1-kanal" shot="front-dusk" index="05" total={TOTAL} />
  <CtaBand
    label="06 / 06 · Call or WhatsApp"
    heading="Let’s talk about your build"
    whatsappMessage={heroCopy.whatsappMessage}
  />
</BaseLayout>
