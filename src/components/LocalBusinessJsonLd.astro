---
import { site } from "../config/site.ts";

// GeneralContractor is a schema.org subtype of HomeAndConstructionBusiness.
// No ratings, reviews or priceRange, by content rule.
const base = Astro.site ?? site.url;
// Temporary: the share image stands in as the logo until the brand-logo change
const logo = new URL("/og-default.png", base).href;

const data = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "@id": new URL("/#business", base).href,
  name: site.name,
  slogan: site.tagline,
  url: new URL("/", base).href,
  logo,
  image: logo,
  telephone: site.phone,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHoursSpecification: site.hours.map((entry) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: entry.days,
    opens: entry.opens,
    closes: entry.closes,
  })),
  areaServed: {
    "@type": "City",
    name: site.address.city,
  },
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>
