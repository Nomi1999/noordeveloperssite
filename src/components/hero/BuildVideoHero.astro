---
/**
 * Home page hero: it plays the 8-second build video of the 1 Kanal house once,
 * from the blueprint, as soon as the page opens, and ends on the finished house
 * at dusk with the Call and WhatsApp actions.
 *
 * Progressive enhancement. The markup and default CSS are the static hero (one
 * screen: the dusk poster, headline, the six phases as a list, Call and
 * WhatsApp), which is what no-JS, reduced-motion, reduced-data and slow-connection
 * visitors get. The inline script below adds html.hero-motion before the hero is
 * parsed when motion is wanted; only then does hero-video.ts load and play the
 * video (public/hero/, see render/README.md). Motion mode paints the video's first
 * frame (the blueprint, as a CSS background, so static visitors never fetch it)
 * until the video itself starts. From the first paint the hero shows the phase
 * overlays (data-phase="intro" until playback starts reads as the Design phase),
 * so nothing swaps out as the video starts; the ruler follows the frame; at the
 * end the video fades to the dusk poster with the Call and WhatsApp actions.
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { withBase } from "../../lib/paths.ts";
import CallButton from "../CallButton.astro";
import WhatsAppButton from "../WhatsAppButton.astro";
import ContactNote from "../ContactNote.astro";
import { heroCopy } from "./hero-copy.ts";

type Orientation = "landscape" | "portrait";
interface Tier {
  id: string;
  width: number;
  height: number;
}

// The finished house at dusk: a photoreal version of the video's last frame. Static mode opens on it; motion mode ends on it
// (public/hero/poster/, written by scripts/enhance-renders.mjs encode). The first matching <source> wins.
const POSTER_TIERS: Record<Orientation, Tier[]> = {
  landscape: [
    { id: "360", width: 640, height: 360 },
    { id: "540", width: 960, height: 540 },
    { id: "1080", width: 1920, height: 1080 },
  ],
  portrait: [
    { id: "360", width: 360, height: 640 },
    { id: "540", width: 540, height: 960 },
  ],
};
const posterSrcset = (o: Orientation, ext: string) =>
  POSTER_TIERS[o].map((t) => `${withBase(`/hero/poster/${o}-${t.id}.${ext}`)} ${t.width}w`).join(", ");
const sources = [
  { media: "(orientation: portrait)", o: "portrait" },
  { media: undefined, o: "landscape" },
] as const;
const fallbackTier = POSTER_TIERS.landscape[POSTER_TIERS.landscape.length - 1];
const { phases, playback } = heroCopy;

// The video manifest (written by scripts/encode-renders.mjs video), embedded so playback needn't wait for a fetch
const manifest = JSON.parse(readFileSync(join(process.cwd(), "public/hero/manifest.json"), "utf8"));
// The first frame, painted under the video in motion mode until the video's own first frame arrives
const firstStyle = (["landscape", "portrait"] as const)
  .map((o) => `--hero-first-${o}: url("${withBase(`/hero/first/${o}.webp`)}")`)
  .join("; ");
---

<script is:inline>
  // Motion only with JS, no reduced-motion or reduced-data preference, no Save-Data and a
  // connection faster than 3G (the video is 1 to 4 MB). Runs before the hero is parsed.
  (function () {
    var c = navigator.connection;
    var mq = function (q) {
      return window.matchMedia && matchMedia(q).matches;
    };
    var slow = c && ["slow-2g", "2g", "3g"].indexOf(c.effectiveType) >= 0;
    if (!mq("(prefers-reduced-motion: reduce)") && !mq("(prefers-reduced-data: reduce)") && !(c && c.saveData) && !slow) {
      document.documentElement.classList.add("hero-motion");
    }
  })();
</script>

<section class="hero" data-hero data-manifest={JSON.stringify(manifest)} aria-labelledby="hero-title">
  <div class="hero__stage" data-hero-stage data-phase="intro" style={firstStyle}>
    <!-- First focusable element; shown on keyboard focus -->
    <a class="hero__skip" href="#after-hero">
      <span>{heroCopy.skip}</span>
      <svg class="hero__skip-arrow" viewBox="0 0 12 16" aria-hidden="true">
        <path d="M6 1v13M1.5 9.5 6 14l4.5-4.5" />
      </svg>
    </a>
    <picture class="hero__poster">
      {
        sources.flatMap(({ media, o }) => [
          <source media={media} type="image/avif" srcset={posterSrcset(o, "avif")} sizes="100vw" />,
          <source media={media} type="image/webp" srcset={posterSrcset(o, "webp")} sizes="100vw" />,
        ])
      }
      <img
        src={withBase(`/hero/poster/landscape-${fallbackTier.id}.webp`)}
        width={fallbackTier.width}
        height={fallbackTier.height}
        alt={heroCopy.imageAlt}
        fetchpriority="high"
        decoding="async"
        data-hero-poster
      />
    </picture>
    <video
      class="hero__video"
      muted
      playsinline
      preload="none"
      disablepictureinpicture
      disableremoteplayback
      aria-hidden="true"
      tabindex="-1"
      data-hero-video
    ></video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">{heroCopy.headline}</h1>
      <div class="hero__swap">
        <div class="hero__lede">
          <p class="hero__intro">{heroCopy.intro}</p>
          <ContactNote hours={false} class="hero__note" />
        </div>
        <h2 class="sr-only">{heroCopy.phasesLabel}</h2>
        <ol class="hero__phases" role="list">
        {
          phases.map((p, i) => (
            <li class="hero__phase" data-index={i}>
              <p class="hero__phase-label">
                <span class="hero__phase-num">{p.number}</span>
                <span aria-hidden="true"> — </span>
                <span class="hero__phase-name">{p.name}</span>
              </p>
              <p class="hero__phase-line">{p.line}</p>
            </li>
          ))
        }
        </ol>
      </div>
      <div class="hero__act">
        <div class="hero__cta">
          <CallButton variant="outline" />
          <WhatsAppButton message={heroCopy.whatsappMessage} variant="primary" />
        </div>
      </div>
    </div>

    <div class="hero__ruler" role="group" aria-label={heroCopy.jumpLabel}>
      <div class="hero__ruler-track">
        <div class="hero__ruler-fill" data-hero-fill></div>
        {
          phases.map((p, i) => (
            <button type="button" class="hero__tick" style={`--at: ${i / phases.length}`} data-hero-jump={i}>
              <span class="hero__tick-text" aria-hidden="true">
                <span class="hero__tick-name">{p.name}</span>
                {p.number}
              </span>
              <span class="sr-only">{`${p.number} ${p.name}`}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Pause, play and replay (WCAG 2.2.2): hidden until the video plays or is refused autoplay -->
    <button type="button" class="hero__toggle" data-hero-toggle data-state="pause" hidden>
      <svg class="hero__toggle-icon" data-icon="pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" /></svg>
      <svg class="hero__toggle-icon" data-icon="play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 2.5v11l8.5-5.5z" /></svg>
      <svg class="hero__toggle-icon" data-icon="replay" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8a5 5 0 1 0 1.5-3.6M3.5 1.5v3h3" /></svg>
      <span class="hero__toggle-text" data-label="pause">{playback.pause}</span>
      <span class="hero__toggle-text" data-label="play">{playback.play}</span>
      <span class="hero__toggle-text" data-label="replay">{playback.replay}</span>
    </button>
  </div>
</section>
<div id="after-hero" class="hero-after" tabindex="-1"></div>

<script>
  import { start } from "./hero-video.ts";

  const root = document.querySelector<HTMLElement>("[data-hero]");
  if (root && document.documentElement.classList.contains("hero-motion")) {
    start(root); // at once: the video is the opening view
  }
</script>

<style>
  /* ---------- static mode (the default) ---------- */
  .hero {
    position: relative;
    background: var(--ink);
  }

  /* Static mode: shown on keyboard focus only (the hero is one screen) */
  .hero__skip {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--noor);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-mono-strong);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-4)));
    --focus-color: var(--paper);
  }

  .hero__skip:focus {
    transform: none;
  }

  .hero__skip-arrow {
    width: 0.75rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
  }

  .hero__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* one screen below the header (the token is the header's minimum; the logo row can add a few px) */
    min-height: calc(100svh - var(--header-height) - var(--space-2));
    overflow: hidden;
    isolation: isolate;
  }

  .hero__poster,
  .hero__poster img,
  .hero__video,
  .hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__poster {
    z-index: -3;
  }

  .hero__poster img {
    object-fit: cover;
  }

  .hero__video {
    z-index: -2;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    background: center / cover no-repeat;
    /* At the end the video gives way to the dusk poster */
    transition: opacity 600ms var(--ease-out);
  }

  /* Legibility: darkens the text corner only (lower-left on wide screens, top on tall ones) */
  .hero__scrim {
    z-index: -1;
    background:
      linear-gradient(to top, rgb(18 18 18 / 0.85), rgb(18 18 18 / 0) 55%),
      linear-gradient(to right, rgb(18 18 18 / 0.55), rgb(18 18 18 / 0) 60%);
  }

  .hero__copy {
    position: relative;
    width: min(100%, var(--container-max));
    margin-inline: auto;
    padding: var(--space-8) var(--gutter) var(--space-7);
  }

  .hero__title {
    max-width: 13ch;
    font-size: var(--text-4xl);
    text-wrap: balance;
  }

  .hero__intro {
    margin-top: var(--space-4);
    max-width: 36ch;
    font-size: var(--text-lg);
    line-height: var(--leading-ui);
    color: var(--paper);
  }

  .hero :global(.hero__note) {
    margin-top: var(--space-5);
    color: var(--concrete-300);
  }

  /* Static mode: the stages read as one line of names; each stage's sentence stays for screen readers */
  .hero__phases {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding: var(--space-3) 0 0;
    border-top: var(--rule-thin) solid var(--concrete-700);
    list-style: none;
  }

  .hero__phase-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-mono-strong);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--noor);
  }

  .hero__phase-line {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    color: var(--concrete-300);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__ruler,
  .hero__toggle {
    display: none;
  }

  /* Small screens: the list shows phase names only (each line stays in the document) */
  @media (max-width: 47.999rem) {
    /* One screen = what is between the header and the fixed Call/WhatsApp bar */
    .hero__stage {
      min-height: calc(100svh - var(--header-height) - var(--space-2) - var(--action-bar-height) - env(safe-area-inset-bottom, 0px));
    }

    /* Without JS the header nav wraps onto a second row instead of collapsing into a toggle */
    :global(html:not(.js)) .hero__stage {
      min-height: calc(100svh - var(--header-height) - var(--space-2) - 3rem - var(--action-bar-height) - env(safe-area-inset-bottom, 0px));
    }

    .hero__copy {
      padding-top: var(--space-7);
      padding-bottom: var(--space-5);
    }

    /* Phones have no hero actions (the fixed bar has them), so the note waits for the closing band.
       This keeps the copy short and the lit house clear. */
    .hero :global(.hero__note) {
      display: none;
    }

    .hero__phases {
      gap: var(--space-1) var(--space-4);
    }

    .hero__cta {
      display: none; /* the fixed Call/WhatsApp bar is on screen below 48rem */
    }
  }

  /* Static mode on wide screens: one column on the dark lower left, the headline on two lines */
  @media (min-width: 64rem) {
    :global(html:not(.hero-motion)) .hero__title {
      max-width: 19ch;
    }

    :global(html:not(.hero-motion)) .hero__scrim {
      background:
        linear-gradient(to top, rgb(18 18 18 / 0.88), rgb(18 18 18 / 0) 60%),
        linear-gradient(to right, rgb(18 18 18 / 0.78), rgb(18 18 18 / 0.5) 40%, rgb(18 18 18 / 0) 65%);
    }
  }

  /* ---------- motion mode: html.hero-motion ---------- */
  /* One screen below the sticky header */
  :global(html.hero-motion) .hero__stage {
    height: calc(100svh - var(--header-offset));
    min-height: 0;
  }

  /* The video (its first frame until it starts) is the opening view; at the end it cross-fades to the dusk poster */
  :global(html.hero-motion) .hero__video {
    opacity: 1;
    background-image: var(--hero-first-landscape);
  }

  @media (orientation: portrait) {
    :global(html.hero-motion) .hero__video {
      background-image: var(--hero-first-portrait);
    }
  }

  :global(html.hero-motion) .hero__poster {
    transition: opacity 600ms var(--ease-out);
  }

  :global(html.hero-motion) .hero__stage:not([data-ended]) .hero__poster {
    opacity: 0;
  }

  :global(html.hero-motion) .hero__stage[data-ended] .hero__video {
    opacity: 0;
  }

  :global(html.hero-motion) .hero__copy {
    position: absolute;
    inset: auto 0 0 0;
    padding-right: calc(var(--gutter) + 4rem);
    padding-bottom: var(--space-8);
  }

  /* The headline stays through the build, at half size, from the first paint */
  :global(html.hero-motion) .hero__title {
    transform-origin: left bottom;
    transform: scale(0.5);
  }

  /* The phases take the place of the opening line, which is for the static hero */
  :global(html.hero-motion) .hero__swap {
    display: grid;
    margin-top: var(--space-4);
  }

  :global(html.hero-motion) .hero__lede {
    display: none;
  }

  :global(html.hero-motion) .hero__phases {
    grid-area: 1 / 1;
    align-self: start;
  }

  /* One phase at a time, stacked in the same place */
  :global(html.hero-motion) .hero__phases {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 36rem;
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  :global(html.hero-motion) .hero__phase {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  :global(html.hero-motion) .hero__phase-label {
    font-size: var(--text-sm);
  }

  :global(html.hero-motion) .hero__phase-line {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    color: var(--paper);
  }

  :global(html.hero-motion) :is([data-phase="intro"], [data-phase="0"]) .hero__phase[data-index="0"],
  :global(html.hero-motion) [data-phase="1"] .hero__phase[data-index="1"],
  :global(html.hero-motion) [data-phase="2"] .hero__phase[data-index="2"],
  :global(html.hero-motion) [data-phase="3"] .hero__phase[data-index="3"],
  :global(html.hero-motion) [data-phase="4"] .hero__phase[data-index="4"],
  :global(html.hero-motion) [data-phase="5"] .hero__phase[data-index="5"] {
    opacity: 1;
    transform: none;
  }

  /* The actions show with the Move in phase and stay at the end; the row is folded away before */
  :global(html.hero-motion) .hero__act {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms var(--ease-out);
  }

  :global(html.hero-motion) [data-phase="5"] .hero__act {
    grid-template-rows: 1fr;
  }

  :global(html.hero-motion) .hero__cta {
    min-height: 0;
    overflow: hidden;
    /* room for the focus ring inside the clip */
    padding: var(--focus-ring);
    margin: calc(var(--space-6) - var(--focus-ring)) calc(-1 * var(--focus-ring)) calc(-1 * var(--focus-ring));
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 300ms var(--ease-out),
      visibility 0s linear 300ms;
  }

  :global(html.hero-motion) [data-phase="5"] .hero__cta {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  /* Pause / play / replay: bottom right, on its own dark ground like the current ruler label */
  :global(html.hero-motion) .hero__toggle:not([hidden]) {
    display: inline-flex;
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-3);
    z-index: 2;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 0;
    background: rgb(18 18 18 / 0.8);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    cursor: pointer;
    --focus-color: var(--noor);
  }

  .hero__toggle:hover {
    color: var(--noor);
  }

  .hero__toggle-icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
  }

  .hero__toggle-icon[data-icon="play"] {
    fill: currentColor;
    stroke-linejoin: round;
  }

  .hero__toggle-icon,
  .hero__toggle-text {
    display: none;
  }

  .hero__toggle[data-state="pause"] :is([data-icon="pause"], [data-label="pause"]),
  .hero__toggle[data-state="play"] :is([data-icon="play"], [data-label="play"]),
  .hero__toggle[data-state="replay"] :is([data-icon="replay"], [data-label="replay"]) {
    display: block;
  }

  /* Architect ruler: six ticks that jump to their stage, a fill that tracks progress */
  :global(html.hero-motion) .hero__ruler {
    display: block;
    position: absolute;
    top: 50%;
    right: var(--gutter);
    height: min(50svh, 24rem);
    transform: translateY(-50%);
  }

  /* A soft dark band behind the ruler: its labels stay legible over the pale concrete frames */
  :global(html.hero-motion) .hero__ruler::before {
    content: "";
    position: absolute;
    top: -3rem;
    bottom: -3rem;
    right: calc(-1 * var(--gutter));
    width: calc(var(--gutter) + 9rem);
    background: linear-gradient(to left, rgb(18 18 18 / 0.82), rgb(18 18 18 / 0.6) 45%, rgb(18 18 18 / 0));
    /* feathered top and bottom, so it reads as shade rather than a panel */
    mask-image: linear-gradient(to bottom, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
    pointer-events: none;
  }

  .hero__ruler-track {
    position: relative;
    width: var(--rule-thin);
    height: 100%;
    background: rgb(201 198 191 / 0.35);
  }

  .hero__ruler-fill {
    position: absolute;
    inset: 0;
    background: var(--noor);
    transform: scaleY(0);
    transform-origin: top;
  }

  .hero__tick {
    position: absolute;
    top: calc(var(--at) * 100%);
    right: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* a 44px target around a small label */
    min-height: 2.75rem;
    padding: 0 0 0 var(--space-3);
    border: 0;
    background: none;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--concrete-300);
    cursor: pointer;
    --focus-color: var(--noor);
  }

  .hero__tick::after {
    content: "";
    width: var(--space-3);
    height: var(--rule-thin);
    background: currentColor;
    transition: width var(--duration-fast) var(--ease-out);
  }

  .hero__tick:hover,
  .hero__tick[aria-current] {
    color: var(--noor);
  }

  .hero__tick:hover::after,
  .hero__tick[aria-current]::after {
    width: var(--space-4);
  }

  /* The current stage is named beside its tick; the others show their number only */
  .hero__tick-name {
    display: none;
  }

  .hero__tick[aria-current] .hero__tick-name {
    display: inline;
  }

  /* The current label gets its own dark ground: it reaches past the shade over the pale frames */
  .hero__tick-text {
    padding: var(--space-1) var(--space-2);
    margin-right: calc(-1 * var(--space-2));
  }

  .hero__tick[aria-current] .hero__tick-text {
    background: rgb(18 18 18 / 0.88);
  }

  .hero__tick-name {
    margin-right: 0.5em;
  }

  /* Short landscape screens (phones on their side): smaller headline */
  @media (orientation: landscape) and (max-height: 32rem) {
    /* Two lines at most, so the copy fits about 300px of stage; already small, so it shrinks less */
    :global(html.hero-motion) .hero__title {
      max-width: 24ch;
      font-size: var(--text-xl);
      transform: scale(0.8);
    }

    :global(html.hero-motion) .hero__swap {
      margin-top: var(--space-2);
    }

    :global(html.hero-motion) .hero__cta {
      margin-top: calc(var(--space-4) - var(--focus-ring));
    }

    :global(html.hero-motion) .hero__copy {
      padding-bottom: var(--space-8);
    }

    .hero__tick {
      min-height: 2rem;
    }
  }

  /* Tall screens: the text sits in the calm sky at the top, actions at the bottom */
  @media (orientation: portrait) {
    /* Dark enough for --paper and --noor copy at AA over the brightest frames, down past the copy */
    :global(html.hero-motion) .hero__scrim {
      background:
        linear-gradient(to bottom, rgb(18 18 18 / 0.9), rgb(18 18 18 / 0.82) 30%, rgb(18 18 18 / 0.4) 46%, rgb(18 18 18 / 0) 60%),
