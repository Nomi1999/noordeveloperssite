---
import "@fontsource/big-shoulders-display/latin-600";
import "@fontsource/big-shoulders-display/latin-800";
import "@fontsource/barlow/latin-400.css";
import "@fontsource/barlow/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../styles/tokens.css";
import "../styles/global.css";

import displayFont from "@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url";
import bodyFont from "@fontsource/barlow/files/barlow-latin-400-normal.woff2?url";

import Seo from "../components/Seo.astro";
import LocalBusinessJsonLd from "../components/LocalBusinessJsonLd.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyActionBar from "../components/StickyActionBar.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Describes the share image; defaults to the brand line */
  ogImageAlt?: string;
  /** Prefilled WhatsApp message for every CTA on the page */
  whatsappMessage?: string;
  noindex?: boolean;
}

const { title, description, ogImage, ogImageAlt, whatsappMessage, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="color-scheme" content="dark" />
    <Seo title={title} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt} noindex={noindex} />
    <LocalBusinessJsonLd />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header whatsappMessage={whatsappMessage} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer whatsappMessage={whatsappMessage} />
    <StickyActionBar whatsappMessage={whatsappMessage} />
  </body>
</html>

<style>
  main {
    flex: 1 0 auto;
  }

  main:focus {
    outline: none;
  }

  /* Space for the fixed mobile action bar, so the footer stays fully visible */
  @media (max-width: 47.999rem) {
    :global(body) {
      padding-bottom: calc(var(--action-bar-height) + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
