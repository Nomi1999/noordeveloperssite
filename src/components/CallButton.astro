---
import { site } from "../config/site.ts";
import { telUrl } from "../lib/contact.ts";
import PhoneIcon from "./icons/PhoneIcon.astro";

interface Props {
  variant?: "primary" | "outline";
  size?: "md" | "sm";
  /** Show the number in the label, so a desktop visitor sees what they are calling */
  showNumber?: boolean;
  class?: string;
}

const { variant = "outline", size = "md", showNumber = false, class: className } = Astro.props;
---

<a
  href={telUrl()}
  class:list={["btn", `btn--${variant}`, size === "sm" && "btn--sm", className]}
  data-action="call"
>
  <PhoneIcon />
  {
    showNumber ? (
      <span>
        <span class="sr-only">{`Call ${site.name} on `}</span>
        <span class="call-number">{site.phoneDisplay}</span>
      </span>
    ) : (
      <span>
        Call<span class="sr-only">{` ${site.name}`}</span>
      </span>
    )
  }
</a>

<style>
  .call-number {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
