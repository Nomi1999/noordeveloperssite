---
import { site } from "../config/site.ts";
import { withBase, withoutBase } from "../lib/paths.ts";

interface Props {
  title: string;
  description: string;
  /** Root-relative or absolute share image; defaults to the branded image */
  ogImage?: string;
  ogImageAlt?: string;
  /** Keep the page out of search results (404, styleguide) */
  noindex?: boolean;
}

const DEFAULT_OG_IMAGE = "/og-default.png";

const {
  title,
  description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = `${site.name}: ${site.tagline}`,
  noindex: noindexPage = false,
} = Astro.props;

const base = Astro.site ?? site.url;
const path = withoutBase(Astro.url.pathname);
const isHome = path === "/";
// The temporary GitHub Pages address (<user>.github.io) carries placeholder details, so it
// stays out of search results; a custom domain is indexed as normal.
const noindex = noindexPage || new URL(base).hostname.endsWith(".github.io");
// Home leads with the company name; every other page is "<Page title> | Noor Developers"
const fullTitle = isHome ? `${site.name} | ${title}` : `${title} | ${site.name}`;
const canonical = new URL(withBase(path), base).href;
const image = new URL(withBase(ogImage), base).href;
const isDefaultImage = ogImage === DEFAULT_OG_IMAGE;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={ogImageAlt} />
{
  isDefaultImage && (
    <>
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={ogImageAlt} />
