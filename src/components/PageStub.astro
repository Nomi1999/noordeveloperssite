---
import CallButton from "./CallButton.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  /** Mono label above the heading, e.g. "02 — Designs" */
  label: string;
  heading: string;
  lead: string;
  whatsappMessage?: string;
}

const { label, heading, lead, whatsappMessage } = Astro.props;
---

<section class="section section--dark stub-hero">
  <div class="container">
    <p class="label text-accent">{label}</p>
    <h1 class="stub-hero__title">{heading}</h1>
    <p class="lead stub-hero__lead">{lead}</p>
    <div class="stub-hero__dim" aria-hidden="true">
      <span class="dim">Faisalabad</span>
      <span class="stub-hero__line"></span>
      <span class="dim">Building the Future</span>
    </div>
  </div>
</section>

<section class="section section--concrete">
  <div class="container stub-body">
    <p class="label">Coming soon</p>
    <h2 class="stub-body__title">This page is being built</h2>
    <p>Talk to us directly in the meantime. Call or send a WhatsApp message and we will get back to you.</p>
    <div class="stub-body__actions">
      <WhatsAppButton message={whatsappMessage} variant="primary" />
      <CallButton variant="outline" />
    </div>
  </div>
</section>

<style>
  .stub-hero {
    position: relative;
    overflow: hidden;
    border-bottom: var(--rule-thin) solid var(--concrete-700);
  }

  .stub-hero__title {
    margin-top: var(--space-4);
    max-width: 14ch;
  }

  .stub-hero__lead {
    margin-top: var(--space-5);
    color: var(--concrete-300);
  }

  .stub-hero__dim {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
    color: var(--concrete-500);
  }

  .stub-hero__line {
    position: relative;
    flex: 1;
    height: var(--rule-thin);
    background: var(--concrete-700);
  }

  .stub-hero__line::before,
  .stub-hero__line::after {
    content: "";
    position: absolute;
    top: calc(-1 * var(--space-2));
    width: var(--rule-thin);
    height: var(--space-4);
    background: var(--concrete-500);
  }

  .stub-hero__line::before {
    left: 0;
  }

  .stub-hero__line::after {
    right: 0;
  }

  .stub-body__title {
    margin-top: var(--space-3);
    font-size: var(--text-2xl);
  }

  .stub-body p:not(.label) {
    margin-top: var(--space-4);
  }

  .stub-body__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
