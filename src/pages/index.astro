---
import BaseLayout from "../layouts/BaseLayout.astro";
import BuildVideoHero from "../components/hero/BuildVideoHero.astro";
import { heroCopy } from "../components/hero/hero-copy.ts";
import Offerings from "../components/sections/Offerings.astro";
import FullyFinished from "../components/sections/FullyFinished.astro";
import WhatWeBuild from "../components/sections/WhatWeBuild.astro";
import Process from "../components/sections/Process.astro";
import FeaturedDesign from "../components/sections/FeaturedDesign.astro";
import CtaBand from "../components/sections/CtaBand.astro";

// Sections after the hero, in the order the home-page spec requires. Their
// headings carry themselves: no section numbers or labels on the home page.
---

<BaseLayout
  title="Building the Future in Faisalabad"
  description="Noor Developers design and build fully finished houses and commercial buildings in Faisalabad. Call or WhatsApp to talk about your build."
  whatsappMessage={heroCopy.whatsappMessage}
>
  <BuildVideoHero />
  <Offerings eyebrow={false} />
  <FullyFinished variant="compact" eyebrow={false} heading="What fully finished means" />
  <WhatWeBuild eyebrow={false} />
  <Process eyebrow={false} />
  <FeaturedDesign slug="1-kanal" shot="front-dusk" eyebrow={false} />
  <CtaBand label={false} dusk heading="Let’s talk about your build" whatsappMessage={heroCopy.whatsappMessage} />
</BaseLayout>
