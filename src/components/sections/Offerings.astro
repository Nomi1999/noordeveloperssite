---
/**
 * The two ways to work with Noor, side by side (stacked on phones).
 * `summary` (home): an image, one line and a link to What We Build for each:
 * the finished house for "Buy", the plan drawn on an empty plot (frame 28 of
 * the hero render, as its own still) for "Build on your plot".
 * `detail` (What We Build): each offering from start to finish.
 */
import { withBase } from "../../lib/paths.ts";
import { Picture } from "astro:assets";
import { offerings } from "../../content/offerings.ts";
import planOnPlot from "../../assets/stills/plan-on-plot.jpg";
import { getRender } from "../../designs/renders.ts";
import RenderFigure from "../RenderFigure.astro";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  variant?: "summary" | "detail";
  index?: string;
  total?: string;
  /** Show the mono label above the heading */
  eyebrow?: boolean;
}

const { variant = "summary", index, total, eyebrow = true } = Astro.props;
const detail = variant === "detail";
const finished = getRender("1-kanal", "street");
const cardSizes = "(min-width: 80rem) 37rem, (min-width: 48rem) 46vw, 100vw";
---

<section class:list={["section offerings", detail ? "section--paper" : "section--concrete"]} aria-labelledby="offerings-title">
  <div class="container">
    <SectionHeader
      index={eyebrow ? index : undefined}
      total={total}
      label={eyebrow ? "Two ways to work with us" : undefined}
      heading="Two ways to work with Noor"
      id="offerings-title"
      intro={detail ? "Buy a home we have already built, or have us design and build on your own plot. Either way, you get it fully finished." : undefined}
    />

    <ul class="offerings__grid" role="list">
      {
        offerings.map((o) => (
          <li class:list={["offer reveal", !detail && "offer--card"]} id={detail ? `offer-${o.id}` : undefined}>
            {!detail &&
              (o.id === "buy" ? (
                <RenderFigure render={finished} sizes={cardSizes} widths={[480, 800, 1200]} caption={false} class="offer__image" />
              ) : (
                <figure class="render offer__image">
                  <div class="render__frame offer__frame">
                    <Picture
                      src={planOnPlot}
                      alt="Amber plan lines drawn across an empty plot between neighbouring houses: a house designed around the land before building starts."
                      formats={["avif", "webp"]}
                      fallbackFormat="jpg"
                      widths={[480, 640, 960]}
                      sizes={cardSizes}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </figure>
              ))}
            <p class="offer__label label">{o.label}</p>
            <h3 class="offer__title">{o.title}</h3>
            <p class="offer__summary">{o.summary}</p>
            {detail ? (
              <>
                <ol class="offer__steps" role="list">
                  {o.steps.map((step, i) => (
                    <li>
                      <span class="offer__num dim" aria-hidden="true">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ol>
                <p class="offer__outcome">{o.outcome}</p>
              </>
            ) : (
              <a class="link-arrow offer__link" href={withBase(`/what-we-build/#offer-${o.id}`)}>
                How it works<span class="sr-only">: {o.title}</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .offerings__grid {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  @media (min-width: 48rem) {
    .offerings__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: var(--rule-thick) solid var(--ink);
    scroll-margin-top: var(--space-6);
  }

  .offer__label {
    color: var(--concrete-700);
  }

  /* Home: image first, then the words */
  .offer--card {
    padding-top: 0;
    border-top: 0;
  }

  .offer--card :global(.offer__image) {
    border-bottom: var(--rule-thick) solid var(--ink);
    margin-bottom: var(--space-2);
  }

  /* Same frame as RenderFigure, whose styles are scoped to it */
  .offer__image {
    margin: 0;
  }

  .offer__frame {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--ink-2);
  }

  .offer__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .offer__title {
    font-size: var(--text-2xl);
  }

  .offer__summary {
    font-size: var(--text-lg);
  }

  .offer__link {
    align-self: flex-start;
    margin-top: auto;
  }

  .offer__steps {
    display: grid;
    gap: 0;
    margin-top: var(--space-2);
  }

  .offer__steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: var(--rule-thin) solid var(--concrete-300);
  }

  .offer__num {
    padding-top: 0.2em;
    color: var(--concrete-700);
  }

  .offer__outcome {
    font-weight: var(--weight-body-strong);
  }
</style>
