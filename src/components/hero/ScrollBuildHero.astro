---
/**
 * Home page hero: it opens on the finished 1 Kanal house at dusk, then, as the
 * visitor scrolls, dissolves to the blueprint and builds the house again.
 *
 * Progressive enhancement. The markup and default CSS are the static hero (one
 * screen: the dusk poster, headline, the six phases as a list, Call and
 * WhatsApp), which is what no-JS, reduced-motion, reduced-data and slow-connection
 * visitors get. The inline script below adds html.hero-scrub before the hero is
 * parsed when scrubbing is wanted; only then does the section grow tall with a
 * sticky stage, and hero-player.ts draws the frame sequence (public/hero/, see
 * render/README.md) onto the canvas. The first INTRO share of the scroll span is
 * the opening state (data-phase="intro"): the canvas stays clear over the dusk
 * poster; the rest of the span runs frames 0 → last.
 */
import { withBase } from "../../lib/paths.ts";
import CallButton from "../CallButton.astro";
import WhatsAppButton from "../WhatsAppButton.astro";
import ContactNote from "../ContactNote.astro";
import { heroCopy } from "./hero-copy.ts";

/** Share of the scroll span spent on the opening dusk screen (half a screen of 3) */
const INTRO = 1 / 6;

type Orientation = "landscape" | "portrait";
interface Tier {
  id: string;
  width: number;
  height: number;
}

// Every mode opens on the finished house at dusk: a photoreal version of the sequence's last frame
// (public/hero/poster/, written by scripts/enhance-renders.mjs encode). The first matching <source> wins.
const POSTER_TIERS: Record<Orientation, Tier[]> = {
  landscape: [
    { id: "360", width: 640, height: 360 },
    { id: "540", width: 960, height: 540 },
  ],
  portrait: [
    { id: "360", width: 360, height: 640 },
    { id: "540", width: 540, height: 960 },
  ],
};
const posterSrcset = (o: Orientation, ext: string) =>
  POSTER_TIERS[o].map((t) => `${withBase(`/hero/poster/${o}-${t.id}.${ext}`)} ${t.width}w`).join(", ");
const sources = [
  { media: "(orientation: portrait)", o: "portrait" },
  { media: undefined, o: "landscape" },
] as const;
const fallbackTier = POSTER_TIERS.landscape[POSTER_TIERS.landscape.length - 1];
const { phases } = heroCopy;
---

<script is:inline>
  // Scrub only with JS, no reduced-motion or reduced-data preference, no Save-Data and a
  // connection faster than 3G (the sequence is several MB). Runs before the hero is parsed.
  (function () {
    var c = navigator.connection;
    var mq = function (q) {
      return window.matchMedia && matchMedia(q).matches;
    };
    var slow = c && ["slow-2g", "2g", "3g"].indexOf(c.effectiveType) >= 0;
    if (!mq("(prefers-reduced-motion: reduce)") && !mq("(prefers-reduced-data: reduce)") && !(c && c.saveData) && !slow) {
      document.documentElement.classList.add("hero-scrub");
    }
  })();
</script>

<section class="hero" data-hero data-intro={INTRO.toFixed(4)} aria-labelledby="hero-title">
  <div class="hero__stage" data-hero-stage data-phase="intro">
    <!-- First focusable element; inside the pinned stage so it stays on screen while scrubbing -->
    <a class="hero__skip" href="#after-hero">
      <span>{heroCopy.skip}</span>
      <svg class="hero__skip-arrow" viewBox="0 0 12 16" aria-hidden="true">
        <path d="M6 1v13M1.5 9.5 6 14l4.5-4.5" />
      </svg>
    </a>
    <picture class="hero__poster">
      {
        sources.flatMap(({ media, o }) => [
          <source media={media} type="image/avif" srcset={posterSrcset(o, "avif")} sizes="100vw" />,
          <source media={media} type="image/webp" srcset={posterSrcset(o, "webp")} sizes="100vw" />,
        ])
      }
      <img
        src={withBase(`/hero/poster/landscape-${fallbackTier.id}.webp`)}
        width={fallbackTier.width}
        height={fallbackTier.height}
        alt={heroCopy.imageAlt}
        fetchpriority="high"
        decoding="async"
        data-hero-poster
      />
    </picture>
    <canvas class="hero__canvas" aria-hidden="true" data-hero-canvas></canvas>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">{heroCopy.headline}</h1>
      <div class="hero__swap">
        <div class="hero__lede">
          <p class="hero__intro">{heroCopy.intro}</p>
          <ContactNote hours={false} class="hero__note" />
        </div>
        <h2 class="sr-only">{heroCopy.phasesLabel}</h2>
        <ol class="hero__phases" role="list">
        {
          phases.map((p, i) => (
            <li class="hero__phase" data-index={i}>
              <p class="hero__phase-label">
                <span class="hero__phase-num">{p.number}</span>
                <span aria-hidden="true"> — </span>
                <span class="hero__phase-name">{p.name}</span>
              </p>
              <p class="hero__phase-line">{p.line}</p>
            </li>
          ))
        }
        </ol>
      </div>
      <div class="hero__act">
        <div class="hero__cta">
          <CallButton variant="outline" />
          <WhatsAppButton message={heroCopy.whatsappMessage} variant="primary" />
        </div>
      </div>
    </div>

    <p class="hero__cue" aria-hidden="true"><span>{heroCopy.scrollCue}</span></p>

    <div class="hero__ruler" role="group" aria-label={heroCopy.jumpLabel}>
      <div class="hero__ruler-track">
        <div class="hero__ruler-fill" data-hero-fill></div>
        {
          phases.map((p, i) => (
            <button type="button" class="hero__tick" style={`--at: ${i / phases.length}`} data-hero-jump={i}>
              <span class="hero__tick-text" aria-hidden="true">
                <span class="hero__tick-name">{p.name}</span>
                {p.number}
              </span>
              <span class="sr-only">{`${p.number} ${p.name}`}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>
<div id="after-hero" class="hero-after" tabindex="-1"></div>

<script>
  import { start } from "./hero-player.ts";

  const root = document.querySelector<HTMLElement>("[data-hero]");
  if (root && document.documentElement.classList.contains("hero-scrub")) {
    // Out of the page's critical path: start when the page is idle after load, or at the first scroll
    let started = false;
    const go = () => {
      if (started) return;
      started = true;
      removeEventListener("scroll", go);
      start(root);
    };
    const idle = () =>
      "requestIdleCallback" in window ? requestIdleCallback(go, { timeout: 1500 }) : setTimeout(go, 200);
    addEventListener("scroll", go, { passive: true });
    if (document.readyState === "complete") idle();
    else addEventListener("load", idle, { once: true });
  }
</script>

<style>
  /* ---------- static mode (the default) ---------- */
  .hero {
    position: relative;
    background: var(--ink);
  }

  /* Static mode: shown on keyboard focus only (the hero is one screen) */
  .hero__skip {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--noor);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-mono-strong);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-4)));
    --focus-color: var(--paper);
  }

  .hero__skip:focus {
    transform: none;
  }

  .hero__skip-arrow {
    width: 0.75rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
  }

  .hero__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* one screen below the header (the token is the header's minimum; the logo row can add a few px) */
    min-height: calc(100svh - var(--header-height) - var(--space-2));
    overflow: hidden;
    isolation: isolate;
  }

  .hero__poster,
  .hero__poster img,
  .hero__canvas,
  .hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__poster {
    z-index: -3;
  }

  .hero__poster img {
    object-fit: cover;
  }

  .hero__canvas {
    z-index: -2;
    object-fit: cover; /* keeps the last frame filling the stage between a resize and the next draw */
    opacity: 0;
    /* Leaving the opening screen, the dusk poster dissolves into the blueprint */
    transition: opacity 600ms var(--ease-out);
  }

  /* Legibility: darkens the text corner only (lower-left on wide screens, top on tall ones) */
  .hero__scrim {
    z-index: -1;
    background:
      linear-gradient(to top, rgb(18 18 18 / 0.85), rgb(18 18 18 / 0) 55%),
      linear-gradient(to right, rgb(18 18 18 / 0.55), rgb(18 18 18 / 0) 60%);
  }

  .hero__copy {
    position: relative;
    width: min(100%, var(--container-max));
    margin-inline: auto;
    padding: var(--space-8) var(--gutter) var(--space-7);
  }

  .hero__title {
    max-width: 13ch;
    font-size: var(--text-4xl);
    text-wrap: balance;
  }

  .hero__intro {
    margin-top: var(--space-4);
    max-width: 36ch;
    font-size: var(--text-lg);
    line-height: var(--leading-ui);
    color: var(--paper);
  }

  .hero :global(.hero__note) {
    margin-top: var(--space-5);
    color: var(--concrete-300);
  }

  /* Static mode: the stages read as one line of names; each stage's sentence stays for screen readers */
  .hero__phases {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding: var(--space-3) 0 0;
    border-top: var(--rule-thin) solid var(--concrete-700);
    list-style: none;
  }

  .hero__phase-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-mono-strong);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--noor);
  }

  .hero__phase-line {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    color: var(--concrete-300);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero__cue {
    display: none;
  }

  .hero__ruler {
    display: none;
  }

  /* Small screens: the list shows phase names only (each line stays in the document) */
  @media (max-width: 47.999rem) {
    /* One screen = what is between the header and the fixed Call/WhatsApp bar */
    .hero__stage {
      min-height: calc(100svh - var(--header-height) - var(--space-2) - var(--action-bar-height) - env(safe-area-inset-bottom, 0px));
    }

    /* Without JS the header nav wraps onto a second row instead of collapsing into a toggle */
    :global(html:not(.js)) .hero__stage {
      min-height: calc(100svh - var(--header-height) - var(--space-2) - 3rem - var(--action-bar-height) - env(safe-area-inset-bottom, 0px));
    }

    .hero__copy {
      padding-top: var(--space-7);
      padding-bottom: var(--space-5);
    }

    /* Phones have no hero actions (the fixed bar has them), so the note waits for the closing band.
       This keeps the copy short and the lit house clear. */
    .hero :global(.hero__note) {
      display: none;
    }

    .hero__phases {
      gap: var(--space-1) var(--space-4);
    }

    .hero__cta {
      display: none; /* the fixed Call/WhatsApp bar is on screen below 48rem */
    }
  }

  /* Static mode on wide screens: one column on the dark lower left, the headline on two lines */
  @media (min-width: 64rem) {
    :global(html:not(.hero-scrub)) .hero__title {
      max-width: 19ch;
    }

    :global(html:not(.hero-scrub)) .hero__scrim {
      background:
        linear-gradient(to top, rgb(18 18 18 / 0.88), rgb(18 18 18 / 0) 60%),
        linear-gradient(to right, rgb(18 18 18 / 0.78), rgb(18 18 18 / 0.5) 40%, rgb(18 18 18 / 0) 65%);
    }
  }

  /* ---------- scrub mode: html.hero-scrub ---------- */
  /* Four screens: the pinned stage plus three of scrolling (half a screen for the opening, the rest for the build) */
  :global(html.hero-scrub) .hero {
    height: calc(3 * 100svh + 100svh);
  }

  /* Pinned just below the sticky header, filling the rest of the screen */
  :global(html.hero-scrub) .hero__stage {
    position: sticky;
    top: var(--header-offset);
    height: calc(100svh - var(--header-offset));
    min-height: 0;
  }

  /* The canvas covers the dusk poster once the build starts */
  :global(html.hero-scrub) .hero__stage[data-ready]:not([data-phase="intro"]) .hero__canvas {
    opacity: 1;
  }

  :global(html.hero-scrub) .hero__copy {
    position: absolute;
    inset: auto 0 0 0;
    padding-right: calc(var(--gutter) + 4rem);
    padding-bottom: var(--space-8);
  }

  /* The headline stays through the build, at half size */
  :global(html.hero-scrub) .hero__title {
    transform-origin: left bottom;
    transition: transform 400ms var(--ease-out);
  }

  :global(html.hero-scrub) .hero__stage:not([data-phase="intro"]) .hero__title {
    transform: scale(0.5);
  }

  /* The opening line and the phases take turns in one place */
  :global(html.hero-scrub) .hero__swap {
    display: grid;
    margin-top: var(--space-4);
  }

  :global(html.hero-scrub) .hero__lede,
  :global(html.hero-scrub) .hero__phases {
    grid-area: 1 / 1;
    align-self: start;
  }

  :global(html.hero-scrub) .hero__intro {
    margin-top: 0;
  }

  :global(html.hero-scrub) .hero__lede {
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out),
      visibility 0s linear 0s;
  }

  :global(html.hero-scrub) .hero__stage:not([data-phase="intro"]) .hero__lede {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-12px);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out),
      visibility 0s linear 300ms;
  }

  /* One phase at a time, stacked in the same place */
  :global(html.hero-scrub) .hero__phases {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 36rem;
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  :global(html.hero-scrub) .hero__phase {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  :global(html.hero-scrub) .hero__phase-label {
    font-size: var(--text-sm);
  }

  :global(html.hero-scrub) .hero__phase-line {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    color: var(--paper);
  }

  :global(html.hero-scrub) [data-phase="0"] .hero__phase[data-index="0"],
  :global(html.hero-scrub) [data-phase="1"] .hero__phase[data-index="1"],
  :global(html.hero-scrub) [data-phase="2"] .hero__phase[data-index="2"],
  :global(html.hero-scrub) [data-phase="3"] .hero__phase[data-index="3"],
  :global(html.hero-scrub) [data-phase="4"] .hero__phase[data-index="4"],
  :global(html.hero-scrub) [data-phase="5"] .hero__phase[data-index="5"] {
    opacity: 1;
    transform: none;
  }

  /* The actions show on the opening screen and with the Move in phase; the row folds away between */
  :global(html.hero-scrub) .hero__act {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms var(--ease-out);
  }

  :global(html.hero-scrub) :is([data-phase="intro"], [data-phase="5"]) .hero__act {
    grid-template-rows: 1fr;
  }

  :global(html.hero-scrub) .hero__cta {
    min-height: 0;
    overflow: hidden;
    /* room for the focus ring inside the clip */
    padding: var(--focus-ring);
    margin: calc(var(--space-6) - var(--focus-ring)) calc(-1 * var(--focus-ring)) calc(-1 * var(--focus-ring));
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 300ms var(--ease-out),
      visibility 0s linear 300ms;
  }

  :global(html.hero-scrub) :is([data-phase="intro"], [data-phase="5"]) .hero__cta {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  /* Bottom centre: the scroll cue (opening screen only) and the skip link, always there */
  :global(html.hero-scrub) .hero__skip {
    position: absolute;
    top: auto;
    left: 50%;
    bottom: var(--space-3);
    z-index: 20;
    padding: var(--space-3) var(--space-3);
    /* its own dark ground, like the current ruler label: the pale build frames reach the bottom edge */
    background: rgb(18 18 18 / 0.8);
    color: var(--paper);
    font-size: var(--text-xs);
    text-decoration: underline;
    text-decoration-thickness: var(--rule-thin);
    text-underline-offset: 0.4em;
    white-space: nowrap;
    transform: translateX(-50%);
    --focus-color: var(--noor);
  }

  :global(html.hero-scrub) .hero__skip:hover {
    color: var(--noor);
  }

  :global(html.hero-scrub) .hero__cue {
    display: block;
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-3) + 2.75rem);
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    color: var(--concrete-300);
    transition: opacity 300ms var(--ease-out);
  }

  :global(html.hero-scrub) .hero__cue span::after {
    content: "";
    display: block;
    width: var(--rule-thin);
    height: var(--space-5);
    margin: var(--space-2) auto 0;
    background: linear-gradient(var(--noor), transparent);
  }

  :global(html.hero-scrub) .hero__stage:not([data-phase="intro"]) .hero__cue {
    opacity: 0;
  }

  /* Architect ruler: six ticks that jump to their stage, a fill that tracks progress */
  :global(html.hero-scrub) .hero__ruler {
    display: block;
    position: absolute;
    top: 50%;
    right: var(--gutter);
    height: min(50svh, 24rem);
    transform: translateY(-50%);
  }

  /* A soft dark band behind the ruler: its labels stay legible over the pale concrete frames */
  :global(html.hero-scrub) .hero__ruler::before {
    content: "";
    position: absolute;
    top: -3rem;
    bottom: -3rem;
    right: calc(-1 * var(--gutter));
    width: calc(var(--gutter) + 9rem);
    background: linear-gradient(to left, rgb(18 18 18 / 0.82), rgb(18 18 18 / 0.6) 45%, rgb(18 18 18 / 0));
    /* feathered top and bottom, so it reads as shade rather than a panel */
    mask-image: linear-gradient(to bottom, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
    pointer-events: none;
  }

  .hero__ruler-track {
    position: relative;
    width: var(--rule-thin);
    height: 100%;
    background: rgb(201 198 191 / 0.35);
  }

  .hero__ruler-fill {
    position: absolute;
    inset: 0;
    background: var(--noor);
    transform: scaleY(0);
    transform-origin: top;
  }

  .hero__tick {
    position: absolute;
    top: calc(var(--at) * 100%);
    right: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* a 44px target around a small label */
    min-height: 2.75rem;
    padding: 0 0 0 var(--space-3);
    border: 0;
    background: none;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--concrete-300);
    cursor: pointer;
    --focus-color: var(--noor);
  }

  .hero__tick::after {
    content: "";
    width: var(--space-3);
    height: var(--rule-thin);
    background: currentColor;
    transition: width var(--duration-fast) var(--ease-out);
  }

  .hero__tick:hover,
  .hero__tick[aria-current] {
    color: var(--noor);
  }

  .hero__tick:hover::after,
  .hero__tick[aria-current]::after {
    width: var(--space-4);
  }

  /* The current stage is named beside its tick; the others show their number only */
  .hero__tick-name {
    display: none;
  }

  .hero__tick[aria-current] .hero__tick-name {
    display: inline;
  }

  /* The current label gets its own dark ground: it reaches past the shade over the pale frames */
  .hero__tick-text {
    padding: var(--space-1) var(--space-2);
    margin-right: calc(-1 * var(--space-2));
  }

  .hero__tick[aria-current] .hero__tick-text {
    background: rgb(18 18 18 / 0.88);
  }

  .hero__tick-name {
    margin-right: 0.5em;
  }

  /* Wide screens below 64rem: the copy reaches the centre, so the cue gives way to the skip link */
  @media (orientation: landscape) and (max-width: 63.999rem) {
    :global(html.hero-scrub) .hero__cue {
      display: none;
    }
  }

  /* Short landscape screens (phones on their side): smaller headline, no note */
  @media (orientation: landscape) and (max-height: 32rem) {
    /* Two lines at most, so the opening screen fits about 300px of stage */
    :global(html.hero-scrub) .hero__title {
      max-width: 24ch;
      font-size: var(--text-xl);
    }

    :global(html.hero-scrub) .hero__intro {
      font-size: var(--text-base);
    }

    /* Already small: shrink less during the build */
    :global(html.hero-scrub) .hero__stage:not([data-phase="intro"]) .hero__title {
      transform: scale(0.8);
    }

    :global(html.hero-scrub) .hero :global(.hero__note) {
      display: none;
    }

    :global(html.hero-scrub) .hero__swap {
      margin-top: var(--space-2);
    }

    :global(html.hero-scrub) .hero__cta {
      margin-top: calc(var(--space-4) - var(--focus-ring));
    }

    :global(html.hero-scrub) .hero__copy {
      padding-bottom: var(--space-8);
    }

    .hero__tick {
      min-height: 2rem;
    }
  }

  /* Tall screens: the text sits in the calm sky at the top, actions at the bottom */
  @media (orientation: portrait) {
    /* Dark enough for --paper and --noor copy at AA over the brightest frames, down past the copy */
    :global(html.hero-scrub) .hero__scrim {
